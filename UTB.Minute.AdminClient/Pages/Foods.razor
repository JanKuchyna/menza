@page "/foods"
@attribute [Authorize(Roles = "admin")]
@inject IHttpClientFactory Clients

<h3>Jídla</h3>

<Shared.Alert Message="@alertMessage" CssClass="@alertClass" />

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="() => NewFood()">Nové jídlo</button>
</div>

@if (foods is null)
{
    <p>Načítání...</p>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Id</th><th>Název</th><th>Popis</th><th>Cena</th><th>Aktivní</th><th></th></tr></thead>
        <tbody>
        @foreach (var f in foods)
        {
            <tr>
                <td>@f.Id</td>
                <td>@f.Name</td>
                <td>@f.Description</td>
                <td>@f.Price</td>
                <td>@(f.IsActive ? "Ano" : "Ne")</td>
                <td>
                    <button class="btn btn-sm btn-secondary me-1" @onclick="() => Edit(f)">Upravit</button>
                    @if (f.IsActive)
                    {
                        <button class="btn btn-sm btn-warning" @onclick="() => Deactivate(f.Id)">Deaktivovat</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => Activate(f.Id)">Aktivovat</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@if (editing)
{
    <div class="mb-3">
        <label class="form-label">Název</label>
        <input class="form-control" @bind="editModel.Name" />
    </div>
    <div class="mb-3">
        <label class="form-label">Popis</label>
        <input class="form-control" @bind="editModel.Description" />
    </div>
    <div class="mb-3">
        <label class="form-label">Cena</label>
        <input type="number" step="0.01" class="form-control" @bind="editModel.Price" />
    </div>
    <button class="btn btn-success" style="display:@(editing ? "inline-block" : "none")" @onclick="Save">Uložit</button>
    <button class="btn btn-secondary ms-2" style="display:@(editing ? "inline-block" : "none")" @onclick="Cancel">Zrušit</button>
}


@code {
    class FoodFormModel
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public decimal Price { get; set; }
    }

    List<FoodDto>? foods;
    bool editing = false;
    FoodFormModel editModel = new();
    EditContext editContext = default!;
    int? editId = null;

    string alertMessage = string.Empty;
    string alertClass = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    async Task Load()
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            foods = await client.GetFromJsonAsync<List<FoodDto>>("/api/foods");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    void NewFood()
    {
        editModel = new FoodFormModel();
        editContext = new EditContext(editModel);
        editId = null;
        editing = true;
        alertMessage = string.Empty;
    }

    void Edit(FoodDto f)
    {
        editModel = new FoodFormModel { Name = f.Name, Description = f.Description, Price = f.Price };
        editContext = new EditContext(editModel);
        editId = f.Id;
        editing = true;
        alertMessage = string.Empty;
    }

    void Cancel()
    {
        Console.WriteLine("cancelled");
        editing = false;
        editId = null;
    }

    async Task Save()
    {
    Console.WriteLine("worked");
        ShowSuccess("Save clicked!");
        StateHasChanged();
        await Task.Delay(1);
        try
        {
            var client = Clients.CreateClient("WebApi");
            if (editId is null)
            {
                var resp = await client.PostAsJsonAsync("/api/foods", new CreateFoodDto(editModel.Name, editModel.Description, editModel.Price));
                resp.EnsureSuccessStatusCode();
                ShowSuccess("Jídlo vytvořeno.");
            }
            else
            {
                var resp = await client.PutAsJsonAsync($"/api/foods/{editId}", new UpdateFoodDto(editModel.Name, editModel.Description, editModel.Price));
                resp.EnsureSuccessStatusCode();
                ShowSuccess("Jídlo upraveno.");
            }

            editing = false;
            await Load();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    async Task Deactivate(int id)
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            var resp = await client.DeleteAsync($"/api/foods/{id}");
            resp.EnsureSuccessStatusCode();
            ShowSuccess("Jídlo deaktivováno.");
            await Load();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    async Task Activate(int id)
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            var resp = await client.PostAsync($"/api/foods/{id}/activate", null);
            resp.EnsureSuccessStatusCode();
            ShowSuccess("Jídlo aktivováno.");
            await Load();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    void ShowError(string message)
    {
        alertMessage = message;
        alertClass = "alert-danger";
    }

    void ShowSuccess(string message)
    {
        alertMessage = message;
        alertClass = "alert-success";
    }
}

@page "/menu"
@inject IHttpClientFactory Clients

<h3>Menu</h3>

<Shared.Alert Message="@alertMessage" CssClass="@alertClass" />

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NewItem">Nová položka</button>
    </div>

@if (menu is null)
{
    <p>Načítání...</p>
}
else
{
    <table class="table table-hover">
        <thead><tr><th>Id</th><th>Datum</th><th>Jídlo</th><th>Dostupné porce</th><th></th></tr></thead>
        <tbody>
        @foreach (var m in menu)
        {
            <tr>
                <td>@m.Id</td>
                <td>@m.Date</td>
                <td>@m.Food.Name</td>
                <td>@m.AvailablePortions</td>
                <td><button class="btn btn-sm btn-secondary" @onclick="() => Edit(m)">Upravit</button></td>
            </tr>
        }
        </tbody>
    </table>
}

@if (editing)
{
    <EditForm Model="editModel" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label class="form-label">Datum</label>
            <InputDate class="form-control" @bind-Value="editModel.Date" />
        </div>
        <div class="mb-3">
            <label class="form-label">Jídlo (ID)</label>
            <InputNumber class="form-control" @bind-Value="editModel.FoodId" />
        </div>
        <div class="mb-3">
            <label class="form-label">Dostupné porce</label>
            <InputNumber class="form-control" @bind-Value="editModel.AvailablePortions" />
        </div>
        <button class="btn btn-success" type="submit">Uložit</button>
        <button class="btn btn-secondary ms-2" type="button" @onclick="Cancel">Zrušit</button>
    </EditForm>
}

@code {
    List<MenuItemDto>? menu;
    bool editing = false;
    CreateMenuItemDto editModel = new(DateOnly.FromDateTime(DateTime.Today), 1, 1);
    int? editId = null;

    string alertMessage = string.Empty;
    string alertClass = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    async Task Load()
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            menu = await client.GetFromJsonAsync<List<MenuItemDto>>("/api/menu");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    void NewItem()
    {
        editing = true;
        editId = null;
        editModel = new CreateMenuItemDto(DateOnly.FromDateTime(DateTime.Today), 1, 1);
        alertMessage = string.Empty;
    }

    void Edit(MenuItemDto m)
    {
        editing = true;
        editId = m.Id;
        editModel = new CreateMenuItemDto(m.Date, m.Food.Id, m.AvailablePortions);
    }

    void Cancel() => editing = false;

    async Task Save()
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            if (editId is null)
            {
                var resp = await client.PostAsJsonAsync("/api/menu", editModel);
                resp.EnsureSuccessStatusCode();
                ShowSuccess("Položka vytvořena.");
            }
            else
            {
                var resp = await client.PutAsJsonAsync($"/api/menu/{editId}", editModel);
                resp.EnsureSuccessStatusCode();
                ShowSuccess("Položka upravena.");
            }

            editing = false;
            await Load();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    void ShowError(string message)
    {
        alertMessage = message;
        alertClass = "alert-danger";
    }

    void ShowSuccess(string message)
    {
        alertMessage = message;
        alertClass = "alert-success";
    }
}

@page "/menu"
@attribute [Authorize(Roles = "admin")]
@inject IHttpClientFactory Clients

<h3>Menu</h3>

<Shared.Alert Message="@alertMessage" CssClass="@alertClass" />

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NewItem">Nová položka</button>
    </div>

@if (menu is null)
{
    <p>Načítání...</p>
}
else
{
    <table class="table table-hover">
        <thead><tr><th>Id</th><th>Datum</th><th>Jídlo</th><th>Dostupné porce</th><th></th></tr></thead>
        <tbody>
        @foreach (var m in menu)
        {
            <tr>
                <td>@m.Id</td>
                <td>@m.Date</td>
                <td>@m.Food.Name</td>
                <td>@m.AvailablePortions</td>
                <td><button class="btn btn-sm btn-secondary" @onclick="() => Edit(m)">Upravit</button></td>
            </tr>
        }
        </tbody>
    </table>
}

@if (editing)
{
    <div class="mb-3">
        <label class="form-label">Datum</label>
        <input type="date" class="form-control" @bind="editModel.Date" />
    </div>
    <div class="mb-3">
        <label class="form-label">Jídlo</label>
        <select class="form-select" @bind="editModel.FoodId">
            <option value="0">-- vyberte jídlo --</option>
            @foreach (var f in _foods?.Where(f => f.IsActive) ?? [])
            {
                <option value="@f.Id">@f.Name (@f.Price Kč)</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Dostupné porce</label>
        <input type="number" class="form-control" @bind="editModel.AvailablePortions" />
    </div>
}
<button class="btn btn-success" style="display:@(editing ? "inline-block" : "none")" @onclick="Save">Uložit</button>
<button class="btn btn-secondary ms-2" style="display:@(editing ? "inline-block" : "none")" @onclick="Cancel">Zrušit</button>

@code {
    class MenuItemFormModel
    {
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        [Range(1, int.MaxValue, ErrorMessage = "Vyberte jídlo.")]
        public int FoodId { get; set; } = 0;
        public int AvailablePortions { get; set; } = 1;
    }

    List<MenuItemDto>? menu;
    List<FoodDto>? _foods;
    bool editing = false;
    MenuItemFormModel editModel = new();
    EditContext editContext = default!;
    int? editId = null;

    string alertMessage = string.Empty;
    string alertClass = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(Load(), LoadFoods());
    }

    async Task Load()
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            menu = await client.GetFromJsonAsync<List<MenuItemDto>>("/api/menu");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    async Task LoadFoods()
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            _foods = await client.GetFromJsonAsync<List<FoodDto>>("/api/foods");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    void NewItem()
    {
        editModel = new MenuItemFormModel();
        editContext = new EditContext(editModel);
        editId = null;
        editing = true;
        alertMessage = string.Empty;
    }

    void Edit(MenuItemDto m)
    {
        editModel = new MenuItemFormModel { Date = m.Date, FoodId = m.Food.Id, AvailablePortions = m.AvailablePortions };
        editContext = new EditContext(editModel);
        editId = m.Id;
        editing = true;
        alertMessage = string.Empty;
    }

    void Cancel() => editing = false;

    async Task Save()
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            if (editId is null)
            {
                var resp = await client.PostAsJsonAsync("/api/menu", new CreateMenuItemDto(editModel.Date, editModel.FoodId, editModel.AvailablePortions));
                resp.EnsureSuccessStatusCode();
                ShowSuccess("Položka vytvořena.");
            }
            else
            {
                var resp = await client.PutAsJsonAsync($"/api/menu/{editId}", new UpdateMenuItemDto(editModel.Date, editModel.FoodId, editModel.AvailablePortions));
                resp.EnsureSuccessStatusCode();
                ShowSuccess("Položka upravena.");
            }

            editing = false;
            await Load();
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    void ShowError(string message)
    {
        alertMessage = message;
        alertClass = "alert-danger";
    }

    void ShowSuccess(string message)
    {
        alertMessage = message;
        alertClass = "alert-success";
    }
}

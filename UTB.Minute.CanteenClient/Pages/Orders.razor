@page "/orders"
@attribute [Authorize(Roles = "cook")]
@inject IHttpClientFactory Clients
@implements IDisposable

<h3>Objednávky (nedokončené)</h3>

<div class="mb-3">
    <div class="alert @alertClass" role="alert" hidden="@(string.IsNullOrEmpty(alertMessage))">@alertMessage</div>
</div>

@if (orders is null)
{
    <p>Načítání...</p>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Id</th><th>Jídlo</th><th>Student</th><th>Stav</th><th>Akce</th></tr></thead>
        <tbody>
        @foreach (var o in orders)
        {
            <tr>
                <td>@o.Id</td>
                <td>@o.MenuItem.Food.Name</td>
                <td>@o.StudentId</td>
                <td>@o.Status</td>
                <td>
                    @if (o.Status == "Preparing")
                    {
                        <button class="btn btn-success btn-sm me-1" @onclick="() => SetReady(o.Id)">Hotovo</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => SetCancelled(o.Id)">Zrušit</button>
                    }
                    else if (o.Status == "Ready")
                    {
                        <button class="btn btn-primary btn-sm me-1" @onclick="() => SetCompleted(o.Id)">Vydáno</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => SetCancelled(o.Id)">Zrušit</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    List<OrderDto>? orders;
    string alertMessage = string.Empty;
    string alertClass = "alert-info";

    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _ = Task.Run(ListenSseAsync);
    }

    async Task ListenSseAsync()
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            using var response = await client.GetAsync("/api/orders/events",
                HttpCompletionOption.ResponseHeadersRead, _cts.Token);
            using var stream = await response.Content.ReadAsStreamAsync(_cts.Token);
            using var reader = new System.IO.StreamReader(stream);

            while (!reader.EndOfStream && !_cts.Token.IsCancellationRequested)
            {
                var line = await reader.ReadLineAsync(_cts.Token);
                if (line?.StartsWith("data:") == true)
                {
                    await InvokeAsync(async () =>
                    {
                        await Load();
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception) { /* connection lost */ }
    }

    async Task Load()
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            var resp = await client.GetAsync("/api/orders");
            if (resp.IsSuccessStatusCode)
                orders = await resp.Content.ReadFromJsonAsync<List<OrderDto>>();
            else
                ShowError($"GET /api/orders failed: {resp.StatusCode}");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    async Task ChangeStatus(int id, string status)
    {
        try
        {
            var client = Clients.CreateClient("WebApi");
            var dto = new UpdateOrderStatusDto(status);
            var resp = await client.PatchAsJsonAsync($"/api/orders/{id}/status", dto);
            if (resp.IsSuccessStatusCode)
            {
                ShowSuccess("Stav změněn.");
                await Load();
            }
            else
            {
                var txt = await resp.Content.ReadAsStringAsync();
                ShowError(txt);
            }
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
    }

    Task SetReady(int id) => ChangeStatus(id, "Ready");
    Task SetCancelled(int id) => ChangeStatus(id, "Cancelled");
    Task SetCompleted(int id) => ChangeStatus(id, "Completed");

    void ShowError(string msg) { alertMessage = msg; alertClass = "alert-danger"; }
    void ShowSuccess(string msg) { alertMessage = msg; alertClass = "alert-success"; }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
